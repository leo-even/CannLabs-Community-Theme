{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "3.2.0",
    "prettier": "3.8.1",
    "stylelint": "17.5.0"
  },
  "scripts": {
    "lint": "pnpm lint:css && pnpm lint:prettier",
    "lint:fix": "pnpm lint:css:fix && pnpm lint:prettier:fix",
    "lint:css": "pnpm stylelint '{common,scss}/**/*.scss' --allow-empty-input",
    "lint:css:fix": "pnpm stylelint '{common,scss}/**/*.scss' --fix --allow-empty-input",
    "lint:prettier": "pnpm prettier '{common,scss}/**/*.scss' --check --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "pnpm prettier '{common,scss}/**/*.scss' -w --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0"
}
